# Copy to .env. Core workflows require no secrets or external services.
HR_HOST=127.0.0.1
HR_PORT=8000
# HR_DATABASE may be an absolute path. Default: data/hr.sqlite3
# HR_DATABASE=
COOKIE_SECURE=0
# A real model is used only when BOTH values are configured. No simulated AI.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_PROVIDER=auto
