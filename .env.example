# Copy to .env. Core workflows require no secrets or external services.
HR_HOST=127.0.0.1
HR_PORT=8000
# HR_DATABASE may be an absolute path. Default: data/hr.sqlite3
# HR_DATABASE=
COOKIE_SECURE=0
# Demo mode never calls a model. Set live and BOTH credentials to enable it.
AI_MODE=demo
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
